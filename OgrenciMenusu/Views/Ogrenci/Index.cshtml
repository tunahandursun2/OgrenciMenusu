    async function odevDersleriniGetir() {

        const select = document.getElementById("odev-ders-secimi");

        if (!select) return;

        try {

            const response = await fetch("/Ogrenci/DersleriGetir");

            const data = await response.json();

            if (!data.success) {
                return;
            }

            data.dersler.forEach(ders => {

                const option = document.createElement("option");

                option.value = ders.id;
                option.textContent = ders.dersAdi;

                select.appendChild(option);

            });

            const farkliOption = document.createElement("option");

            farkliOption.value = "farkli";
            farkliOption.textContent = "Farklı bir ders...";

            select.appendChild(farkliOption);

        }
        catch (error) {

            console.error("Dersler alınamadı:", error);

        }
    }


    function odevDersSecimiDegisti() {

        const select = document.getElementById("odev-ders-secimi");

        const farkliAlan = document.getElementById("farkli-ders-alani");

        if (select.value === "farkli") {

            farkliAlan.style.display = "block";

        }
        else {

            farkliAlan.style.display = "none";

        }
    }


    function odevFormunuKapat() {

        document.getElementById("odev-ekle-alani").innerHTML = "";

