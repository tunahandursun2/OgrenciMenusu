<main class="ogrenci-duzeni">

    <aside class="yan-menu">

        <h1 class="yan-menu-baslik">
            Öğrenci <span>Menüsü</span>
        </h1>

        <p class="kullanici-adi">
            Hoş geldin, <strong>@User.Identity?.Name</strong>
        </p>

        <nav class="menu-listesi">

            <button class="menu-butonu"
                    type="button"
                    onclick="dersPrograminiAc()">
                Ders Programı
            </button>

            <button class="menu-butonu"
                    type="button"
                    onclick="akademikTakipAc()">
                Akademik Takip
            </button>

            <button class="menu-butonu"
                    type="button"
                    onclick="yksAc()">
                YKS
            </button>

            <button class="menu-butonu" type="button">
                İstatistik
            </button>

            <button class="menu-butonu"
                    type="button"
                    onclick="dersEkleAc()">
                Derslerim
            </button>

        </nav>

        <div class="yan-menu-alt">

            <div class="tarih-saat">

                <div id="guncel-tarih"></div>

                <div id="guncel-saat" class="saat"></div>

                <form asp-controller="Hesap"
                      asp-action="Cikis"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="cikis-butonu">
                        Çıkış Yap
                    </button>

                </form>

            </div>

        </div>

    </aside>

    <section class="icerik-alani">

        <div class="icerik-yer-tutucu">
            İçeriklerinizi burada göreceksiniz.
        </div>

    </section>

</main>

<script>

    /* TARİH VE SAAT */

    function tarihSaatGuncelle() {

        const simdi = new Date();

        const gun = String(simdi.getDate()).padStart(2, '0');
        const ay = String(simdi.getMonth() + 1).padStart(2, '0');
        const yil = simdi.getFullYear();

        const saat = String(simdi.getHours()).padStart(2, '0');
        const dakika = String(simdi.getMinutes()).padStart(2, '0');

        document.getElementById("guncel-tarih").textContent =
            `${gun}.${ay}.${yil}`;

        document.getElementById("guncel-saat").textContent =
            `${saat}.${dakika}`;
    }

    tarihSaatGuncelle();

    setInterval(tarihSaatGuncelle, 1000);

    yaklasanOdevleriGetir();


    /* ==========================================
       DERS PROGRAMI
       ========================================== */

    let programDersleri = [];


    function dersPrograminiAc() {

        document.querySelector(".icerik-yer-tutucu").innerHTML = `

                    <div class="ders-programi-icerik">

                            <div class="ders-programi-baslik-satiri">

            <h2 class="ders-programi-baslik">
                Ders Programı
            </h2>

            <button type="button"
                    id="program-ders-sil-butonu"
                    class="program-ders-sil-butonu"
                    onclick="programDersSilModunuDegistir()">
                Ders Sil
            </button>

        </div>

                        <p class="ders-programi-aciklama">
                            Haftalık ders programını buradan oluşturabilirsin.
                        </p>

                        <div class="ders-programi-duzeni">

                            <div class="program-dersler-karti">

                                <h3 class="program-dersler-baslik">
                                    Derslerim
                                </h3>

                                <div id="program-ders-listesi"
                                     class="program-ders-listesi">

                                    <div class="program-ders-bos">
                                        Dersler yükleniyor...
                                    </div>

                                </div>

                            </div>

                            <div class="program-tablo-kapsayici">

                                <table class="program-tablosu">

                                    <thead>

                                        <tr>

                                            <th class="program-saat-basligi">
                                                Saat
                                            </th>

                                            <th class="program-gun-basligi">
                                                Pazartesi
                                            </th>

                                            <th class="program-gun-basligi">
                                                Salı
                                            </th>

                                            <th class="program-gun-basligi">
                                                Çarşamba
                                            </th>

                                            <th class="program-gun-basligi">
                                                Perşembe
                                            </th>

                                            <th class="program-gun-basligi">
                                                Cuma
                                            </th>

                                            <th class="program-gun-basligi">
                                                Cumartesi
                                            </th>

                                            <th class="program-gun-basligi">
                                                Pazar
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <tr>
                                            <td class="program-saat">06</td>
                                            <td class="program-hucre" data-gun="0" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="1" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="2" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="3" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="4" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="5" data-saat="6"></td>
                                            <td class="program-hucre" data-gun="6" data-saat="6"></td>
