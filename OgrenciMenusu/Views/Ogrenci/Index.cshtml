    function netHesapla(dogruId, yanlisId) {

        const dogru =
            parseFloat(
                document.getElementById(dogruId).value
            ) || 0;

        const yanlis =
            parseFloat(
                document.getElementById(yanlisId).value
            ) || 0;

        return dogru - (yanlis / 4);
    }


    function netBicimlendir(deger) {

        if (deger < 0) {
            deger = 0;
        }

        return deger
            .toFixed(2)
            .replace(".", ",");
    }


    function tytHesapla() {

        const turkce =
            netHesapla(
                "tyt-turkce-dogru",
                "tyt-turkce-yanlis"
            );

        const sosyal =
            netHesapla(
                "tyt-sosyal-dogru",
                "tyt-sosyal-yanlis"
            );

        const matematik =
            netHesapla(
                "tyt-mat-dogru",
                "tyt-mat-yanlis"
            );

        const fen =
            netHesapla(
                "tyt-fen-dogru",
                "tyt-fen-yanlis"
            );

        const toplam =
            turkce +
            sosyal +
            matematik +
            fen;

        document.getElementById(
            "tyt-turkce-sonuc"
        ).textContent =
            netBicimlendir(turkce);

        document.getElementById(
            "tyt-sosyal-sonuc"
        ).textContent =
            netBicimlendir(sosyal);

        document.getElementById(
            "tyt-mat-sonuc"
        ).textContent =
            netBicimlendir(matematik);

        document.getElementById(
            "tyt-fen-sonuc"
        ).textContent =
            netBicimlendir(fen);

        document.getElementById(
            "tyt-toplam"
        ).textContent =
            netBicimlendir(toplam);
    }


