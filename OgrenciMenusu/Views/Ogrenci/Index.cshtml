    function gecmisOdevleriGoster() {

        const alan = document.getElementById("gecmis-odevler-alani");

        if (!alan) {
            return;
        }

        const liste = document.getElementById("gecmis-odevler-listesi");
        const ok = document.getElementById("gecmis-odevler-ok");

        if (liste.style.display === "none") {

            liste.style.display = "block";
            ok.textContent = "▲";

        } else {

            liste.style.display = "none";
            ok.textContent = "▼";

        }
    }


    async function gecmisOdevleriGetir() {

        const alan = document.getElementById("gecmis-odevler-alani");

        if (!alan) {
            return;
        }

        try {

            const response = await fetch("/Ogrenci/OdevleriGetir");
            const data = await response.json();

            if (!data.success) {
                alan.innerHTML = "";
                return;
            }

            const gecmisOdevler = data.odevler
                .filter(o => o.tamamlandi)
                .sort((a, b) => {
                    return new Date(b.tamamlanmaTarihi) -
                        new Date(a.tamamlanmaTarihi);
                })
                .slice(0, 10);

            let html = `
                    <div class="gecmis-odevler-kutu">

                        <div class="gecmis-odevler-baslik"
                             onclick="gecmisOdevleriGoster()">

                            <span>Geçmiş Ödevler</span>

                            <span id="gecmis-odevler-ok">▼</span>

                        </div>

                        <div id="gecmis-odevler-listesi"
                             style="display: none;">
                `;

            if (gecmisOdevler.length === 0) {

                html += `
                        <div class="gecmis-odev-yok">
                            Henüz tamamlanan ödev bulunmuyor.
                        </div>
                    `;

            } else {

                gecmisOdevler.forEach(odev => {

                    const teslimTarihi = new Date(odev.teslimTarihi);
                    const tamamlanmaTarihi = new Date(odev.tamamlanmaTarihi);

                    const teslimGun = String(teslimTarihi.getDate()).padStart(2, "0");
                    const teslimAy = String(teslimTarihi.getMonth() + 1).padStart(2, "0");
                    const teslimYil = teslimTarihi.getFullYear();

                    const tamamGun = String(tamamlanmaTarihi.getDate()).padStart(2, "0");
                    const tamamAy = String(tamamlanmaTarihi.getMonth() + 1).padStart(2, "0");
                    const tamamYil = tamamlanmaTarihi.getFullYear();

                    html += `
                            <div class="gecmis-odev-karti">

                                <div class="gecmis-odev-bilgi">

                                    <div class="gecmis-odev-adi">
                                        ${odev.odevAdi}
                                    </div>

                                    <div class="gecmis-odev-ders">
                                        ${odev.dersAdi}
                                    </div>

                                    <div class="gecmis-odev-tarih">
                                        Teslim: ${teslimGun}.${teslimAy}.${teslimYil}
                                        &nbsp; • &nbsp;
                                        Tamamlandı: ${tamamGun}.${tamamAy}.${tamamYil}
                                    </div>

                                </div>

                                <div class="gecmis-odev-durum">
                                    ✓ Tamamlandı
                                </div>

                            </div>
                        `;

                });

            }

            html += `
                        </div>
                    </div>
                `;

            alan.innerHTML = html;

        }
        catch (error) {

            console.error("Geçmiş ödevler alınamadı:", error);

            alan.innerHTML = "";
        }
