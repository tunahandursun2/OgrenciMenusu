    function yksGeriSayiminiGuncelle() {

        const sinavTarihi =
            new Date("2027-06-19T10:00:00");

        const simdi =
            new Date();

        const fark =
            sinavTarihi - simdi;

        const gunElementi =
            document.getElementById("yks-gun");

        if (!gunElementi) {
            return;
        }

        if (fark <= 0) {

            document.getElementById("yks-gun").textContent = "000";
            document.getElementById("yks-saat").textContent = "00";
            document.getElementById("yks-dakika").textContent = "00";
            document.getElementById("yks-saniye").textContent = "00";

            return;
        }

        const gun =
            Math.floor(
                fark /
                (1000 * 60 * 60 * 24)
            );

        const saat =
            Math.floor(
                (fark /
                    (1000 * 60 * 60)) % 24
            );

        const dakika =
            Math.floor(
                (fark /
                    (1000 * 60)) % 60
            );

        const saniye =
            Math.floor(
                (fark / 1000) % 60
            );

        document.getElementById("yks-gun").textContent =
            String(gun).padStart(3, '0');

        document.getElementById("yks-saat").textContent =
            String(saat).padStart(2, '0');

        document.getElementById("yks-dakika").textContent =
            String(dakika).padStart(2, '0');

        document.getElementById("yks-saniye").textContent =
            String(saniye).padStart(2, '0');
    }


    setInterval(() => {

        if (document.getElementById("yks-gun")) {
            yksGeriSayiminiGuncelle();
        }

    }, 1000);


