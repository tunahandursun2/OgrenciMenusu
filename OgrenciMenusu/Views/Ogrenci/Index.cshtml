@{
    ViewData["Title"] = "Öğrenci Menüsü";
}

<style>


    body {
        margin: 0;
        background: #f5f7fb !important;
        color: #18212f;
        font-family: Inter, Arial, Helvetica, sans-serif;
    }




    /* ÖDEVLERİM */

    .odev-ekle-form select,
    .odev-ekle-form input[type="text"],
    .odev-ekle-form input[type="date"] {
        background: #ffffff !important;
        color: #222222 !important;
        border: 1px solid #d5d8e0 !important;
    }

        .odev-ekle-form select option {
            background: #ffffff !important;
            color: #222222 !important;
        }

    .odev-ekle-form input::placeholder {
        color: #888888 !important;
    }

    .odev-ekle-form select:focus,
    .odev-ekle-form input:focus {
        background: #ffffff !important;
        color: #222222 !important;
        outline: none;
        border-color: #5758ee !important;
    }

    .odev-form-alani select,
    .odev-form-alani input {
        background: #ffffff;
        color: #222222;
        border: 1px solid #d6d9e0;
    }

        .odev-form-alani select option {
            background: #ffffff;
            color: #222222;
        }

        .odev-form-alani input::placeholder {
            color: #888888;
        }

    .yaklasan-odevler-kutu {
        position: fixed;
        right: 25px;
        bottom: 25px;
        width: 330px;
        background: white;
        border: 1px solid #e3e3ea;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
        z-index: 9999;
    }

    .yaklasan-odevler-kapat {
        position: absolute;
        right: 10px;
        top: 8px;
        border: none;
        background: transparent;
        color: #777;
        font-size: 22px;
        cursor: pointer;
        line-height: 1;
    }

        .yaklasan-odevler-kapat:hover {
            color: #333;
        }

    .yaklasan-odevler-baslik {
        font-size: 16px;
        font-weight: 600;
        color: #222;
        margin-bottom: 12px;
        padding-right: 20px;
    }

    .yaklasan-odev {
        padding: 11px 0;
        border-bottom: 1px solid #eeeef3;
    }

        .yaklasan-odev:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .yaklasan-odev-bilgi {
        min-width: 0;
    }

    .yaklasan-odev-adi {
        font-size: 14px;
        font-weight: 600;
        color: #333;
    }

    .yaklasan-odev-ders {
        font-size: 12px;
        color: #777;
        margin-top: 3px;
    }

    .yaklasan-odev-tarih {
        font-size: 12px;
        color: #d93025;
        margin-top: 5px;
    }

    @@media (max-width: 700px) {

        .yaklasan-odevler-kutu {
            right: 15px;
            left: 15px;
            bottom: 15px;
            width: auto;
        }
    }

    .gecmis-odevler-kutu {
        background: white;
        border: 1px solid #e7e7ee;
        border-radius: 12px;
        margin-top: 20px;
        overflow: hidden;
    }

    .gecmis-odevler-baslik {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        background: #f5f6fb;
        font-size: 16px;
        font-weight: 600;
        color: #333;
        cursor: pointer;
        user-select: none;
    }

        .gecmis-odevler-baslik:hover {
            background: #eef0f8;
        }

    #gecmis-odevler-ok {
        font-size: 13px;
        color: #666;
    }

    #gecmis-odevler-listesi {
        padding: 5px 18px;
    }

    .gecmis-odev-karti {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #eeeef3;
    }

        .gecmis-odev-karti:last-child {
            border-bottom: none;
        }

    .gecmis-odev-bilgi {
        min-width: 0;
    }

    .gecmis-odev-adi {
        font-size: 15px;
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
    }

    .gecmis-odev-ders {
        font-size: 13px;
        color: #5758ee;
        margin-bottom: 5px;
    }

    .gecmis-odev-tarih {
        font-size: 12px;
        color: #777;
    }

    .gecmis-odev-durum {
        flex-shrink: 0;
        color: #188038;
        font-size: 13px;
        font-weight: 600;
    }

    .gecmis-odev-yok {
        padding: 20px 0;
        color: #777;
        font-size: 14px;
    }

    @@media (max-width: 700px) {

        .gecmis-odev-karti {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    .aktif-odevler-baslik {
        font-size: 19px;
        font-weight: 600;
        color: #222;
        margin-bottom: 15px;
    }

    .odev-ders-grubu {
        background: white;
        border: 1px solid #e7e7ee;
        border-radius: 12px;
        margin-bottom: 15px;
        overflow: hidden;
    }

    .odev-ders-baslik {
        background: #f5f6fb;
        padding: 13px 18px;
        font-size: 15px;
        font-weight: 600;
        color: #333;
        border-bottom: 1px solid #e7e7ee;
    }

    .odev-listesi {
        padding: 5px 18px;
    }

    .odev-karti {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #eeeeF3;
        gap: 15px;
    }

        .odev-karti:last-child {
            border-bottom: none;
        }

    .odev-bilgi {
        min-width: 0;
    }

    .odev-adi {
        font-size: 15px;
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
    }

    .odev-tarih {
        font-size: 13px;
        color: #777;
    }

    .odev-islemler {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .odev-tamamla-btn {
        border: none;
        background: #5758ee;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
    }

    .odev-sil-btn {
        border: 1px solid #e0e0e5;
        background: white;
        color: #d93025;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
    }

    .odev-tamamla-btn:hover {
        background: #4647d8;
    }

    .odev-sil-btn:hover {
        background: #fff5f5;
    }

    .odevlerim-icerik {
        width: 100%;
    }

    .odevlerim-ust {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
        margin-left: 15px;
    }

        .odevlerim-ust h2 {
            margin: 0;
            font-size: 24px;
            color: #222;
        }

    .odev-ekle-btn {
        border: none;
        background: #5758ee;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        transition: 0.2s;
    }

        .odev-ekle-btn:hover {
            background: #4647d8;
        }

    .odev-ekle-form {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 25px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        border: 1px solid #e7e7ee;
    }

        .odev-ekle-form h3 {
            margin: 0 0 22px 0;
            font-size: 19px;
            color: #222;
        }

    .odev-form-satir {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
    }

        .odev-form-satir label {
            width: 130px;
            font-size: 14px;
            font-weight: 600;
            color: #444;
        }

        .odev-form-satir input,
        .odev-form-satir select {
            flex: 1;
            max-width: 420px;
            height: 42px;
            padding: 0 12px;
            border: 1px solid #d8d8e2;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
            background: white;
        }

            .odev-form-satir input:focus,
            .odev-form-satir select:focus {
                border-color: #5758ee;
            }

    .odev-form-alt {
        display: flex;
        gap: 10px;
        margin-left: 130px;
        margin-top: 8px;
    }

    .odev-kaydet-btn {
        border: none;
        background: #5758ee;
        color: white;
        padding: 10px 18px;
        border-radius: 7px;
        font-size: 14px;
        cursor: pointer;
    }

        .odev-kaydet-btn:hover {
            background: #4647d8;
        }

    .odev-iptal-btn {
        border: 1px solid #d5d5df;
        background: white;
        color: #555;
        padding: 10px 18px;
        border-radius: 7px;
        font-size: 14px;
        cursor: pointer;
    }

        .odev-iptal-btn:hover {
            background: #f5f5f8;
        }

    .odev-hata {
        margin-top: 15px;
        color: #d93025;
        font-size: 13px;
    }

    .odev-basari {
        margin-top: 15px;
        color: #188038;
        font-size: 13px;
    }

    #aktif-odevler-alani {
        width: 100%;
    }

    @@media (max-width: 700px) {

        .odevlerim-ust {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .odev-form-satir {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }

            .odev-form-satir label {
                width: auto;
            }

            .odev-form-satir input,
            .odev-form-satir select {
                width: 100%;
                max-width: none;
            }

        .odev-form-alt {
            margin-left: 0;
        }
    }



    .konu-ekle-ders-karti {
        width: 100%;
        margin-bottom: 15px;
        border: 1px solid #e6e9ef;
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
    }

    .konu-ekle-ders-baslik {
        padding: 13px 16px;
        background: #f5f7fb;
        border-bottom: 1px solid #e6e9ef;
        font-size: 14px;
        font-weight: 700;
        color: #303642;
    }

    .konu-ekle-ders-konulari {
        display: flex;
        flex-direction: column;
    }

    .konu-ekle-konu-satiri {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 16px;
        border-bottom: 1px solid #eef0f4;
        font-size: 13px;
        color: #454c59;
    }

        .konu-ekle-konu-satiri:last-child {
            border-bottom: none;
        }


    /* AKADEMİK TAKİP */

    .konu-ekle-alani select,
    .konu-ekle-alani input {
        background: #ffffff;
        color: #303642;
        color-scheme: light;
    }

        .konu-ekle-alani select option {
            background: #ffffff;
            color: #303642;
        }

    .konu-ekle-mevcut {
        margin-top: 35px;
    }

        .konu-ekle-mevcut h3 {
            margin: 0 0 15px 0;
            font-size: 17px;
            color: #303642;
        }

    .konu-ekle-satiri {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
        padding: 13px 15px;
        margin-bottom: 10px;
        border: 1px solid #e6e9ef;
        border-radius: 9px;
        background: #ffffff;
    }

    .konu-ekle-satiri-bilgi {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .konu-ekle-satiri-bilgi strong {
            font-size: 13px;
            color: #303642;
        }

        .konu-ekle-satiri-bilgi span {
            font-size: 13px;
            color: #7a8392;
        }

    .konu-sil-butonu {
        border: none;
        background: #e74c3c;
        color: white;
        padding: 7px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .konu-sil-butonu:hover {
            background: #c0392b;
        }

    .konu-ekle-bos {
        font-size: 13px;
        color: #7a8392;
        padding: 10px 0;
    }


    .konu-ekle-alani {
        width: 100%;
        max-width: 600px;
    }

        .konu-ekle-alani h3 {
            margin: 0 0 20px 0;
            font-size: 18px;
            color: #303642;
        }

        .konu-ekle-alani select,
        .konu-ekle-alani input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 14px;
            margin-bottom: 12px;
            border: 1px solid #dfe3ea;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

            .konu-ekle-alani select:focus,
            .konu-ekle-alani input:focus {
                border-color: #5758ee;
            }

        .konu-ekle-alani button {
            border: none;
            background: #5758ee;
            color: white;
            padding: 11px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

            .konu-ekle-alani button:hover {
                background: #4647d8;
            }

    #konu-ekle-mesaj {
        margin-top: 12px;
        font-size: 13px;
        color: #5758ee;
    }

    .konu-ders-karti {
        width: 100%;
        border: 1px solid #e6e9ef;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 15px;
        box-sizing: border-box;
    }

    .konu-ders-baslik {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        color: #303642;
    }

        .konu-ders-baslik span {
            font-size: 12px;
            color: #7a8392;
        }

    .konu-listesi {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .konu-satiri {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #454c59;
        cursor: pointer;
    }

        .konu-satiri input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

    .konu-tamamlandi {
        text-decoration: line-through;
        color: #9299a5;
    }


    .akademik-icerik {
        width: 100%;
        box-sizing: border-box;
    }

    .akademik-sekmeleri {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #e6e9ef;
        padding-bottom: 15px;
        margin-bottom: 35px;
    }

    .akademik-sekmesi {
        border: none;
        background: transparent;
        color: #7a8392;
        padding: 10px 17px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .akademik-sekmesi:hover {
            background: #f0efff;
            color: #5758ee;
        }

        .akademik-sekmesi.aktif {
            background: #5758ee;
            color: white;
        }

    .akademik-bos-icerik {
        width: 100%;
        min-height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8a93a3;
        font-size: 14px;
    }


    .program-ders-blogu-adi {
        padding-right: 28px;
        box-sizing: border-box;
    }

    .program-ders-blogu {
        position: absolute;
    }

        .program-ders-blogu .program-ders-sil-butonu {
            position: absolute;
            top: 2px;
            right: 2px;
            margin: 0;
            padding: 2px 5px;
            font-size: 8px;
            line-height: 1;
            z-index: 10;
        }

    .ders-programi-baslik-satiri {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

        .ders-programi-baslik-satiri .program-ders-sil-butonu {
            background: #e53935;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 7px 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

            .ders-programi-baslik-satiri .program-ders-sil-butonu:hover {
                background: #c62828;
            }

    .program-ders-blogu .program-ders-sil-butonu {
        background: #e53935;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 3px 7px;
        font-size: 9px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 3px;
    }

        .program-ders-blogu .program-ders-sil-butonu:hover {
            background: #c62828;
        }

    .ogrenci-duzeni {
        min-height: calc(100vh - 78px);
        display: flex;
        background: #f5f7fb;
    }

    .yan-menu {
        width: 245px;
        min-height: calc(100vh - 78px);
        background: #ffffff;
        border-right: 1px solid #e6e9ef;
        padding: 32px 20px 25px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .yan-menu-baslik {
        margin: 0 0 35px 10px;
        color: #18212f;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

        .yan-menu-baslik span {
            color: #5758ee;
        }

    .kullanici-adi {
        margin: -20px 10px 28px;
        color: #7a8392;
        font-size: 13px;
    }

        .kullanici-adi strong {
            color: #5758ee;
            font-weight: 700;
        }

    .menu-listesi {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .menu-butonu {
        width: 100%;
        min-height: 50px;
        border: none;
        border-radius: 10px;
        background: transparent;
        color: #697386;
        padding: 0 14px;
        display: flex;
        align-items: center;
        text-align: left;
        font-size: 14px;
        font-weight: 650;
        cursor: pointer;
        transition: .2s;
    }

        .menu-butonu:hover {
            background: #f0efff;
            color: #5758ee;
        }

    .yan-menu-alt {
        margin-top: auto;
        display: flex;
        justify-content: center;
        text-align: center;
    }

    .tarih-saat {
        width: 100%;
        padding-top: 20px;
        border-top: 1px solid #e6e9ef;
        color: #7a8392;
        font-size: 13px;
        line-height: 1.7;
    }

        .tarih-saat .saat {
            color: #18212f;
            font-size: 17px;
            font-weight: 750;
        }

    .cikis-butonu {
        display: block;
        width: 100%;
        margin-top: 12px;
        height: 40px;
        border: 1px solid #eadfe2;
        border-radius: 8px;
        background: #fff7f8;
        color: #c35a6d;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .cikis-butonu:hover {
            background: #fdecef;
        }

    .icerik-alani {
        flex: 1;
        padding: 45px 50px;
        box-sizing: border-box;
        background: #f5f7fb;
        overflow-x: auto;
    }

    .icerik-yer-tutucu {
        width: 100%;
        min-height: 500px;
        border: 1px dashed #dfe3ea;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a2a9b5;
        font-size: 14px;
        box-sizing: border-box;
    }

    /* DERS EKLE */

    .ders-ekle-icerik {
        width: 100%;
        box-sizing: border-box;
    }

    .ders-ekle-baslik {
        margin: 0 0 8px;
        color: #18212f;
        font-size: 27px;
        font-weight: 800;
    }

    .ders-ekle-aciklama {
        margin: 0 0 30px;
        color: #8a92a0;
        font-size: 13px;
    }

    .ders-ekle-duzeni {
        display: grid;
        grid-template-columns: minmax(300px, 1fr) minmax(300px, 1fr);
        gap: 25px;
        align-items: start;
    }

    .ders-ekle-karti {
        background: #ffffff;
        border: 1px solid #e6e9ef;
        border-radius: 16px;
        padding: 25px;
        box-sizing: border-box;
    }

    .ders-ekle-kart-baslik {
        margin: 0 0 18px;
        color: #18212f;
        font-size: 20px;
        font-weight: 800;
    }

    .ders-girdi-etiketi {
        display: block;
        margin-bottom: 8px;
        color: #697386;
        font-size: 13px;
        font-weight: 700;
    }

    .ders-girdisi {
        width: 100%;
        height: 45px;
        border: 1px solid #dfe3ea;
        border-radius: 9px;
        padding: 0 12px;
        box-sizing: border-box;
        outline: none;
        color: #18212f;
        background: #fafaff;
        font-size: 13px;
    }

        .ders-girdisi:focus {
            border-color: #5758ee;
            background: #ffffff;
        }

    .ders-kaydet-butonu {
        width: 100%;
        height: 45px;
        margin-top: 12px;
        border: none;
        border-radius: 9px;
        background: #5758ee;
        color: white;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

        .ders-kaydet-butonu:hover {
            background: #4849d9;
        }

    .ders-mesaji {
        display: none;
        margin-top: 12px;
        color: #5758ee;
        font-size: 12px;
        text-align: center;
    }

    .ders-listesi {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 400px;
        overflow-y: auto;
    }

    .ders-ogesi {
        min-height: 48px;
        padding: 0 10px 0 14px;
        background: #fafaff;
        border: 1px solid #e6e9ef;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #4f5969;
        font-size: 13px;
        font-weight: 650;
