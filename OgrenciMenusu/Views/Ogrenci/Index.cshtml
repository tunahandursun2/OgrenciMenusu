    async function dersleriGetir() {

        const liste =
            document.getElementById("ders-listesi");

        if (!liste) {
            return;
        }

        try {

            const cevap =
                await fetch("/Ogrenci/DersleriGetir");

            const veri =
                await cevap.json();

            if (!veri.success ||
                !veri.dersler ||
                veri.dersler.length === 0) {

                liste.innerHTML = `
                            <div class="ders-bos">
                                Henüz ders eklenmemiş.
                            </div>
                        `;

                return;
            }

            liste.innerHTML = "";

            veri.dersler.forEach(ders => {

                const oge =
                    document.createElement("div");

                oge.className =
                    "ders-ogesi";

                const ad =
                    document.createElement("span");

                ad.textContent =
                    ders.dersAdi;

                const buton =
                    document.createElement("button");

                buton.type = "button";

                buton.className =
                    "ders-sil-butonu";

                buton.textContent =
                    "Sil";

                buton.onclick = function () {

                    dersSil(
                        ders.id,
                        ders.dersAdi
                    );

                };

                oge.appendChild(ad);
                oge.appendChild(buton);

                liste.appendChild(oge);

            });

        }
        catch (hata) {

            liste.innerHTML = `
                        <div class="ders-bos">
                            Dersler yüklenirken bir hata oluştu.
                        </div>
                    `;

            console.error(hata);
        }
    }


    async function dersSil(id, dersAdi) {

        const onay =
            confirm(
                `"${dersAdi}" dersini silmek istediğinize emin misiniz?`
            );

        if (!onay) {
            return;
        }

        try {

            const cevap =
                await fetch("/Ogrenci/DersSil", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                    },

                    body:
                        "id=" +
                        encodeURIComponent(id)
                });

            const veri =
                await cevap.json();

            if (!veri.success) {

                alert(
                    veri.message ||
                    "Ders silinemedi."
                );

                return;
            }

            await dersleriGetir();


            /*
             * Ders Derslerim'den silindiyse,
             * programda bulunan aynı dersleri de siliyoruz.
             */

            programDersleri =
                programDersleri.filter(ders => {

                    return ders.dersAdi !== dersAdi;

                });


            if (
                document.querySelector(
                    ".program-tablo-kapsayici"
                )
            ) {

                programDersleriniCiz();

            }

        }
        catch (hata) {

            console.error(hata);

            alert(
                "Ders silinirken bir hata oluştu."
            );
        }
    }


    async function dersKaydet() {

        const girdi =
            document.getElementById("ders-adi");

        const mesaj =
            document.getElementById("ders-mesaji");

        if (!girdi || !mesaj) {
            return;
        }

        const dersAdi =
            girdi.value.trim();

        if (dersAdi === "") {

            mesaj.textContent =
                "Ders adı boş olamaz.";

            mesaj.style.display = "block";

            return;
        }

        try {

            const cevap =
                await fetch("/Ogrenci/DersEkle", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                    },

                    body:
                        "dersAdi=" +
                        encodeURIComponent(dersAdi)
                });

            const veri =
                await cevap.json();

            if (!veri.success) {

                mesaj.textContent =
                    veri.message || "Ders eklenemedi.";

                mesaj.style.display = "block";

                return;
            }

            girdi.value = "";

            mesaj.textContent =
                "Ders başarıyla eklendi.";

            mesaj.style.display = "block";

            await dersleriGetir();

            setTimeout(() => {

                if (mesaj) {
                    mesaj.style.display = "none";
                }

            }, 2000);

        }
        catch (hata) {

            mesaj.textContent =
                "Ders eklenirken bir hata oluştu.";

            mesaj.style.display = "block";

            console.error(hata);
        }
    }


