    async function odeviKaydet() {

        const dersSecimi =
            document.getElementById("odev-ders-secimi").value;

        const odevAdi =
            document.getElementById("odev-adi").value.trim();

        const teslimTarihi =
            document.getElementById("odev-teslim-tarihi").value;

        const mesaj =
            document.getElementById("odev-form-mesaj");


        if (!dersSecimi) {
            mesaj.innerHTML =
                `<div class="odev-hata">Lütfen ders seçin.</div>`;
            return;
        }


        if (!odevAdi) {
            mesaj.innerHTML =
                `<div class="odev-hata">Ödev adı boş olamaz.</div>`;
            return;
        }


        if (!teslimTarihi) {
            mesaj.innerHTML =
                `<div class="odev-hata">Teslim tarihi seçin.</div>`;
            return;
        }


        let dersId = "";
        let dersAdi = "";


        if (dersSecimi === "farkli") {

            dersAdi =
                document.getElementById("odev-farkli-ders").value.trim();

            if (!dersAdi) {
                mesaj.innerHTML =
                    `<div class="odev-hata">Ders adını yazın.</div>`;
                return;
            }

        } else {

            dersId = dersSecimi;

            const select =
                document.getElementById("odev-ders-secimi");

            dersAdi =
                select.options[select.selectedIndex].text;
        }


        const formData = new URLSearchParams();

        formData.append("dersId", dersId);
        formData.append("dersAdi", dersAdi);
        formData.append("odevAdi", odevAdi);
        formData.append("teslimTarihi", teslimTarihi);


        try {

            const response = await fetch("/Ogrenci/OdevEkle", {
                method: "POST",
                headers: {
                    "Content-Type":
                        "application/x-www-form-urlencoded"
                },
                body: formData.toString()
            });


            const data = await response.json();


            if (data.success) {

                mesaj.innerHTML =
                    `<div class="odev-basari">
                            Ödev başarıyla eklendi.
                        </div>`;

                // Listeyi anında güncelle
                await aktifOdevleriGetir();
                await gecmisOdevleriGetir();
                await yaklasanOdevleriGetir();


                // Formu temizle
                document.getElementById("odev-adi").value = "";
                document.getElementById("odev-teslim-tarihi").value = "";
                document.getElementById("odev-ders-secimi").value = "";

                document.getElementById("farkli-ders-alani").style.display =
                    "none";

            } else {

                mesaj.innerHTML =
                    `<div class="odev-hata">
                            ${data.message}
                        </div>`;
            }

        }
        catch (error) {

            console.error("Ödev eklenirken hata:", error);

            mesaj.innerHTML =
                `<div class="odev-hata">
                        Ödev eklenirken bir hata oluştu.
                    </div>`;
        }
    }


