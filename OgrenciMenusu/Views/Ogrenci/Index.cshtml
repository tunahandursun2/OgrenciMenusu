    async function aktifOdevleriGetir() {

        const alan = document.getElementById("aktif-odevler-alani");

        try {

            const response = await fetch("/Ogrenci/OdevleriGetir");
            const data = await response.json();

            if (!data.success) {
                alan.innerHTML = `
                        <div class="akademik-bos-icerik">
                            Ödevler alınamadı.
                        </div>
                    `;
                return;
            }

            const aktifOdevler = data.odevler.filter(o => !o.tamamlandi);

            if (aktifOdevler.length === 0) {
                alan.innerHTML = `
                        <div class="akademik-bos-icerik">
                            Henüz aktif ödev bulunmuyor.
                        </div>
                    `;
                return;
            }

            const gruplar = {};

            aktifOdevler.forEach(odev => {

                if (!gruplar[odev.dersAdi]) {
                    gruplar[odev.dersAdi] = [];
                }

                gruplar[odev.dersAdi].push(odev);

            });

            let html = `
                    <div class="aktif-odevler-baslik">
                        Aktif Ödevler
                    </div>
                `;

            Object.keys(gruplar).forEach(dersAdi => {

                html += `
                        <div class="odev-ders-grubu">

                            <div class="odev-ders-baslik">
                                ${dersAdi}
                            </div>

                            <div class="odev-listesi">
                    `;

                gruplar[dersAdi].forEach(odev => {

                    const tarih = new Date(odev.teslimTarihi);

                    const gun = String(tarih.getDate()).padStart(2, "0");
                    const ay = String(tarih.getMonth() + 1).padStart(2, "0");
                    const yil = tarih.getFullYear();

                    html += `
                            <div class="odev-karti">

                                <div class="odev-bilgi">

                                    <div class="odev-adi">
                                        ${odev.odevAdi}
                                    </div>

                                    <div class="odev-tarih">
                                        Teslim: ${gun}.${ay}.${yil}
                                    </div>

                                </div>

                                <div class="odev-islemler">

                                    <button class="odev-tamamla-btn"
                                            onclick="odeviTamamla(${odev.id})">
                                        Tamamlandı
                                    </button>

                                    <button class="odev-sil-btn"
                                            onclick="odeviSil(${odev.id})">
                                        Sil
                                    </button>

                                </div>

                            </div>
                        `;

                });

                html += `
                            </div>
                        </div>
                    `;

            });

            alan.innerHTML = html;

        }
        catch (error) {

            console.error("Ödevler alınamadı:", error);

            alan.innerHTML = `
                    <div class="akademik-bos-icerik">
                        Ödevler yüklenirken hata oluştu.
                    </div>
                `;
        }
    }

