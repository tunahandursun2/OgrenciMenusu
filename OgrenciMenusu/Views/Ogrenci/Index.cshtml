    function pomodoroAc() {

        aktifSekmeBelirle("sekme-pomodoro");

        document.getElementById(
            "yks-icerik-alani"
        ).innerHTML = `

                            <div class="geri-sayim-alani">

                                <p id="pomodoro-modu"
                                   class="geri-sayim-etiketi">
                                    ÇALIŞMA
                                </p>

                                <h2 id="pomodoro-basligi">
                                    Pomodoro
                                </h2>

                                <div class="geri-sayim-kutulari">

                                    <div class="geri-sayim-kutusu">

                                        <span id="pomodoro-dakika"
                                              class="geri-sayim-sayisi">
                                            25
                                        </span>

                                        <span class="geri-sayim-birimi">
                                            DAKİKA
                                        </span>

                                    </div>

                                    <div class="geri-sayim-kutusu">

                                        <span id="pomodoro-saniye"
                                              class="geri-sayim-sayisi">
                                            00
                                        </span>

                                        <span class="geri-sayim-birimi">
                                            SANİYE
                                        </span>

                                    </div>

                                </div>

                                <div class="net-islemleri"
                                     style="width: 300px; margin-top: 30px;">

                                    <button id="pomodoro-baslat"
                                            class="net-islem-butonu hesapla-butonu"
                                            type="button"
                                            onclick="pomodoroBaslatDuraklat()">
                                        Başlat
                                    </button>

                                    <button id="pomodoro-sifirla"
                                            class="net-islem-butonu kaydet-butonu"
                                            type="button"
                                            onclick="pomodoroSifirla()">
                                        Sıfırla
                                    </button>

                                </div>

                            </div>
                        `;
    }


    let pomodoroZaman = null;

    let pomodoroDakika = 25;
    let pomodoroSaniye = 0;

    let pomodoroCalisiyor = false;
    let pomodoroMola = false;


    function pomodoroBaslatDuraklat() {

        if (pomodoroCalisiyor) {

            clearInterval(pomodoroZaman);

            pomodoroZaman = null;

            pomodoroCalisiyor = false;

            const buton =
                document.getElementById("pomodoro-baslat");

            if (buton) {
                buton.textContent = "Devam Et";
            }

            return;
        }

        pomodoroCalisiyor = true;

        const buton =
            document.getElementById("pomodoro-baslat");

        if (buton) {
            buton.textContent = "Duraklat";
        }

        pomodoroZaman =
            setInterval(pomodoroGuncelle, 1000);
    }


    function pomodoroGuncelle() {

        if (!document.getElementById("pomodoro-dakika")) {

            clearInterval(pomodoroZaman);

            pomodoroZaman = null;
            pomodoroCalisiyor = false;

            return;
        }

        if (pomodoroSaniye > 0) {

            pomodoroSaniye--;

        }
        else if (pomodoroDakika > 0) {

            pomodoroDakika--;

            pomodoroSaniye = 59;

        }
        else {

            pomodoroModunuDegistir();

            return;
        }

        pomodoroEkraniniGuncelle();
    }


    function pomodoroModunuDegistir() {

        clearInterval(pomodoroZaman);

        pomodoroZaman = null;

        pomodoroCalisiyor = false;

        if (!pomodoroMola) {

            pomodoroMola = true;

            pomodoroDakika = 5;
            pomodoroSaniye = 0;

            const mod =
                document.getElementById("pomodoro-modu");

            const baslik =
                document.getElementById("pomodoro-basligi");

            const buton =
                document.getElementById("pomodoro-baslat");

            if (mod) {
                mod.textContent = "MOLA";
            }

            if (baslik) {
                baslik.textContent = "Mola Zamanı";
            }

            if (buton) {
                buton.textContent = "Başlat";
            }

        }
        else {

            pomodoroMola = false;

            pomodoroDakika = 25;
            pomodoroSaniye = 0;

            const mod =
                document.getElementById("pomodoro-modu");

            const baslik =
                document.getElementById("pomodoro-basligi");

            const buton =
                document.getElementById("pomodoro-baslat");

            if (mod) {
                mod.textContent = "ÇALIŞMA";
            }

            if (baslik) {
                baslik.textContent = "Pomodoro";
            }

            if (buton) {
                buton.textContent = "Başlat";
            }
        }

        pomodoroEkraniniGuncelle();
    }


    function pomodoroEkraniniGuncelle() {

        const dakika =
            document.getElementById("pomodoro-dakika");

        const saniye =
            document.getElementById("pomodoro-saniye");

        if (!dakika || !saniye) {
            return;
        }

        dakika.textContent =
            String(pomodoroDakika).padStart(2, "0");

        saniye.textContent =
            String(pomodoroSaniye).padStart(2, "0");
    }


    function pomodoroSifirla() {

        clearInterval(pomodoroZaman);

        pomodoroZaman = null;

        pomodoroCalisiyor = false;
        pomodoroMola = false;

        pomodoroDakika = 25;
        pomodoroSaniye = 0;

        const mod =
            document.getElementById("pomodoro-modu");

        const baslik =
            document.getElementById("pomodoro-basligi");

        const buton =
            document.getElementById("pomodoro-baslat");

        if (mod) {
            mod.textContent = "ÇALIŞMA";
        }

        if (baslik) {
            baslik.textContent = "Pomodoro";
        }

        if (buton) {
            buton.textContent = "Başlat";
        }

        pomodoroEkraniniGuncelle();
    }


