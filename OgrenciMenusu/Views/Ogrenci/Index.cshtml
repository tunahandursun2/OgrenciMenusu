    async function konuKaydet() {

        const dersId = document.getElementById("konu-ders-secimi").value;
        const konuAdi = document.getElementById("konu-adi").value.trim();
        const mesaj = document.getElementById("konu-ekle-mesaj");

        if (!dersId) {

            mesaj.textContent = "Lütfen ders seçiniz.";
            return;
        }

        if (!konuAdi) {

            mesaj.textContent = "Lütfen konu adı giriniz.";
            return;
        }

        const veri = new URLSearchParams();

        veri.append("dersId", dersId);
        veri.append("konuAdi", konuAdi);

        try {

            const cevap = await fetch('/Ogrenci/KonuEkle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: veri.toString()
            });

            const sonuc = await cevap.json();

            if (sonuc.success) {

                mesaj.textContent = "Konu başarıyla eklendi.";

                document.getElementById("konu-adi").value = "";

                konuEkleListesiniGetir();

            }
            else {

                mesaj.textContent = sonuc.message;

            }

        }
        catch (hata) {

            console.error(hata);

            mesaj.textContent = "Bir hata oluştu.";

        }
    }


    async function konuEkleListesiniGetir() {

        const alan = document.getElementById("konu-ekle-listesi");

        if (!alan) {
            return;
        }

        try {

            const cevap = await fetch('/Ogrenci/KonulariGetir');

            const sonuc = await cevap.json();

            if (!sonuc.success || sonuc.konular.length === 0) {

                alan.innerHTML = `
                        <div class="konu-ekle-bos">
                            Henüz konu eklenmemiş.
                        </div>
                    `;

                return;
            }


            const dersler = {};


            sonuc.konular.forEach(konu => {

                if (!dersler[konu.dersId]) {

                    dersler[konu.dersId] = {
                        dersAdi: konu.dersAdi,
                        konular: []
                    };

                }

                dersler[konu.dersId].konular.push(konu);

            });


            let html = "";


            Object.values(dersler).forEach(ders => {

                html += `

                        <div class="konu-ekle-ders-karti">

                            <div class="konu-ekle-ders-baslik">

                                ${programHtmlGuvenliMetin(ders.dersAdi)}

                            </div>

                            <div class="konu-ekle-ders-konulari">
                    `;


                ders.konular.forEach(konu => {

                    html += `

                            <div class="konu-ekle-konu-satiri">

                                <span>
                                    ${programHtmlGuvenliMetin(konu.konuAdi)}
                                </span>

                                <button type="button"
                                        class="konu-sil-butonu"
                                        onclick="konuSil(${konu.id})">
                                    Sil
                                </button>

                            </div>

                        `;

                });


                html += `

                            </div>

                        </div>

                    `;

            });


            alan.innerHTML = html;

        }
        catch (hata) {

            console.error(hata);

            alan.innerHTML = `
                    <div class="konu-ekle-bos">
                        Konular yüklenirken bir hata oluştu.
                    </div>
                `;
        }
    }


    async function konuSil(id) {

        const onay = confirm("Bu konuyu silmek istediğinize emin misiniz?");

        if (!onay) {
            return;
        }

        const veri = new URLSearchParams();

        veri.append("id", id);

        try {

            const cevap = await fetch('/Ogrenci/KonuSil', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: veri.toString()
            });

            const sonuc = await cevap.json();

            if (sonuc.success) {

                konuEkleListesiniGetir();

            }
            else {

                alert(sonuc.message);

            }

        }
        catch (hata) {

            console.error(hata);

            alert("Konu silinirken bir hata oluştu.");

        }
    }


    async function konulariGetirVeGoster() {

        const alan =
            document.getElementById("akademik-icerik-alani");


        const konuEkleButonu = `
                    <div class="akademik-konu-ekle-butonu-alani">
                        <button class="akademik-konu-ekle-butonu"
                                type="button"
                                onclick="akademikSekmeAc('konu-ekle')">
                            + Konu Ekle / Kaldır
                        </button>
                    </div>
                `;

        alan.innerHTML = `
                    <div class="konu-takip-alani">
                        <div class="akademik-bos-icerik">
                            Konular yükleniyor...
                        </div>
                        ${konuEkleButonu}
                    </div>
                `;


        try {

            const cevap =
                await fetch('/Ogrenci/KonulariGetir');

            const sonuc =
                await cevap.json();


            let html = `<div class="konu-takip-alani">`;


            if (!sonuc.success || sonuc.konular.length === 0) {

                html += `
                            <div class="akademik-bos-icerik">
                                Henüz konu eklenmemiş.
                            </div>
                            ${konuEkleButonu}
                        </div>
                        `;

                alan.innerHTML = html;

                return;
            }


            html += `<div class="konu-kartlari">`;

            const dersler = {};


            sonuc.konular.forEach(konu => {

                if (!dersler[konu.dersId]) {

                    dersler[konu.dersId] = {
                        dersAdi: konu.dersAdi,
                        konular: []
                    };

                }

                dersler[konu.dersId].konular.push(konu);

            });


            Object.values(dersler).forEach(ders => {

                const tamamlanan =
                    ders.konular.filter(k => k.tamamlandi).length;

                const toplam =
                    ders.konular.length;

                const yuzde =
                    toplam === 0
                        ? 0
                        : Math.round((tamamlanan / toplam) * 100);


                html += `

                            <div class="konu-ders-karti">

                                <div class="konu-ders-baslik">

                                    <strong>
                                        ${programHtmlGuvenliMetin(ders.dersAdi)}
                                    </strong>

                                    <span>
                                        ${tamamlanan}/${toplam} tamamlandı (%${yuzde})
                                    </span>

                                </div>


                                <div class="konu-listesi">

                        `;


                ders.konular.forEach(konu => {

                    html += `

                                <label class="konu-satiri">

                                    <input type="checkbox"
                                           ${konu.tamamlandi ? "checked" : ""}
                                           onchange="konuTamamlandiDegistir(${konu.id})">

                                    <span class="${konu.tamamlandi ? "konu-tamamlandi" : ""}">
                                        ${programHtmlGuvenliMetin(konu.konuAdi)}
                                    </span>

                                </label>

                            `;

                });


                html += `

                                </div>

                            </div>

                        `;

            });


            html += `
                        </div>
                        ${konuEkleButonu}
                    </div>
                    `;

            alan.innerHTML = html;

        }
        catch (hata) {

            console.error(hata);

            alan.innerHTML = `
                        <div class="konu-takip-alani">
                            <div class="akademik-bos-icerik">
                                Konular yüklenirken bir hata oluştu.
                            </div>
                            ${konuEkleButonu}
                        </div>
                    `;
        }
    }


    async function konuTamamlandiDegistir(id) {

        const veri = new URLSearchParams();

        veri.append("id", id);

        try {

            const cevap = await fetch('/Ogrenci/KonuTamamlandiDegistir', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: veri.toString()
            });

            const sonuc = await cevap.json();

            if (sonuc.success) {

                konulariGetirVeGoster();

            }

        }
        catch (hata) {

            console.error(hata);

        }
    }


