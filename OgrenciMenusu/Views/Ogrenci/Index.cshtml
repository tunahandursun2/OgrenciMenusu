        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

        .ders-sil-butonu:hover {
            background: #fdecef;
        }

    .ders-bos {
        padding: 30px 15px;
        border: 1px dashed #dfe3ea;
        border-radius: 10px;
