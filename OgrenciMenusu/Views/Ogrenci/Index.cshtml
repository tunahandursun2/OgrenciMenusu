    function netSonucuKaydet(sinav) {

        const mesajId =
            sinav === "TYT"
                ? "tyt-kaydet-mesaji"
                : "ayt-kaydet-mesaji";

        const mesaj =
            document.getElementById(mesajId);

        mesaj.style.display = "block";

        setTimeout(() => {

            mesaj.style.display = "none";

        }, 3000);
    }


